{
  "name": "eslint-filtered-fix",
  "version": "0.3.0",
  "description": "Gain more control over how ESLint fixes are applied.",
  "main": "index.js",
  "bin": {
    "eslint-filtered-fix": "./bin/eslint-filtered-fix.js"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "src",
    "bin"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src index.js --cache"
  },
  "keywords": [
    "eslint",
    "fix",
    "autofix"
  ],
  "author": "Ian VanSchooten <ian.vanschooten+npm@gmail.com>",
  "repository": "ianvs/eslint-filtered-fix",
  "bugs": "https://github.com/ianvs/eslint-filtered-fix/issues/",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=7.0.0"
  },
  "dependencies": {
    "optionator": "^0.9.1"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "shelljs": "^0.10.0"
  }
}
